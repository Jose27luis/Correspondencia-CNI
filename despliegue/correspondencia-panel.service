[Unit]
Description=Panel web de Correspondencia CNI
After=network.target correspondencia-api.service

[Service]
Type=simple
WorkingDirectory=/var/www/Correspondencia-CNI/frontend
Environment=NODE_ENV=production
Environment=PORT=3021
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3021
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=correspondencia-panel

[Install]
WantedBy=multi-user.target
