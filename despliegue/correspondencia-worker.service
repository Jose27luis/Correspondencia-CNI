[Unit]
Description=Worker de envíos de Correspondencia CNI
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
WorkingDirectory=/var/www/Correspondencia-CNI/backend
EnvironmentFile=/var/www/Correspondencia-CNI/backend/.env
ExecStart=/var/www/Correspondencia-CNI/backend/bin/worker
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=correspondencia-worker

[Install]
WantedBy=multi-user.target
